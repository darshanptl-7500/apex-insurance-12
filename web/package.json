{
  "name": "apex-insurance-web",
  "private": true,
  "description": "Single-origin hybrid host: AngularJS shell + Angular 8 islands",
  "scripts": {
    "build:ng8": "cd apex-ng8 && npm run build -- --base-href /ng8/ --deploy-url /ng8/",
    "build:ng8:prod": "cd apex-ng8 && npm run build:prod -- --base-href /ng8/ --deploy-url /ng8/",
    "start": "node serve-hybrid.js",
    "start:hybrid": "npm run build:ng8 && node serve-hybrid.js"
  }
}
